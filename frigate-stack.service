[Unit]
Description=Frigate NVR — bring up the container and validate the pipeline
Documentation=file:///home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/STARTUP.md
After=docker.service network-online.target nvidia-persistenced.service local-fs.target
Requires=docker.service
Wants=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate
ExecStart=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/bring-up.sh
EnvironmentFile=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/.env
StandardOutput=journal
StandardError=journal
# Strict success policy: only exit 0 from bring-up.sh (all 14 pipeline
# steps OK or WARN, no FAILs) is treated as success. Exits 1..5 are
# real failures and mark the service as failed; the watchdog timer
# will then auto-rerun bring-up.sh every 5 min until it returns 0.
# This change surfaces the stale docker-compose.yml validation
# failure mode that previously went unnoticed for 14 h because the
# old policy conflated exit-1 (steps FAIL) with success.
SuccessExitStatus=0
TimeoutStartSec=420
Restart=no

[Install]
WantedBy=multi-user.target
