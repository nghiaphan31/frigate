# =============================================================================
# frigate.service — systemd unit for Frigate NVR (Calypso / RTX 5060 Ti)
# =============================================================================
#
# Install:
#   sudo cp frigate.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable frigate
#   sudo systemctl start frigate
#
# Or use the helper:
#   sudo ./deploy-frigate.sh install-service
#
# Why this unit exists:
#   docker-compose restart: always leaves ZMQ IPC sockets broken → process_fps=0.
#   The `restart: unless-stopped` policy in docker-compose.calypso.yml makes Docker
#   auto-start the container on host reboot, but Docker's built-in restart does NOT
#   run the ZMQ-fix stop+start cycle. This unit runs `deploy-frigate.sh boot` after
#   Docker starts, which waits for the TRT engine build and then does the ZMQ-fix
#   stop+start cycle to ensure all cameras have process_fps > 0.
#
# Boot sequence:
#   1. Docker daemon starts (docker.service)
#   2. Docker auto-starts the frigate container (restart: unless-stopped)
#   3. This unit runs `deploy-frigate.sh boot`:
#      a. wait_healthy (API up)
#      b. wait_detector_ready 300 || true (TRT engine build, up to 5 min)
#      c. zmq_fix_cycle (stop + 20s sleep + start)
#      d. wait_healthy + wait_detector_ready 120 || true
#      e. wait_all_processing 120 (confirm no ZMQ-stuck camera: camera_fps>0 AND process_fps=0)
#      f. ZMQ retry loop: up to MAX_ZMQ_RETRIES=3 extra cycles if any camera is still stuck
# =============================================================================

[Unit]
Description=Frigate NVR ZMQ-fix boot sequence
Documentation=https://docs.frigate.video
# Must run after Docker is up and the container has been auto-started
After=docker.service network-online.target
Requires=docker.service
# Do not conflict with docker.service stop
PartOf=docker.service

[Service]
Type=oneshot
# Run as the deploy user (owns the project directory and docker socket access)
User=nghia-phan
WorkingDirectory=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate
ExecStart=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/deploy-frigate.sh boot
# TimeoutStartSec calculation (worst case: cold TRT cache + 3 ZMQ retry cycles):
#   wait_healthy initial:          120s
#   wait_detector_ready (cold):    300s
#   zmq_fix_cycle × 4 (1+3):      100s  (4 × 25s)
#   wait_healthy × 4:              480s  (4 × 120s)
#   wait_all_processing × 4:       480s  (4 × 120s)
#   Total worst case:             ~1480s → 1800s gives 5 min safety margin
#   Typical reboot (warm TRT):    <400s  (well within 1800s)
TimeoutStartSec=1800
# Log to journald — view with: journalctl -u frigate -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=frigate-boot
# Retry on failure (e.g. Docker not ready yet)
Restart=on-failure
RestartSec=30
# Only retry a few times — if it keeps failing, something is wrong
StartLimitIntervalSec=300
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
