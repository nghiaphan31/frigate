[Unit]
Description=Frigate NVR — periodic health check + auto-recover
Documentation=file:///home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/STARTUP.md
# Always wait for the docker stack service so we do not fight a concurrent bring-up.
After=docker.service frigate-stack.service
Wants=frigate-stack.service

[Service]
Type=oneshot
# NOTE: paths must match the real on-disk location. If you ever move the
# repo, re-run ./install-systemd.sh so the installed units in
# /etc/systemd/system are rewritten. Hand-editing is fine for one-offs
# but a re-install is the durable fix.
WorkingDirectory=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate
ExecStart=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/bring-up.sh
EnvironmentFile=/home/nghia-phan/AGENTIC_DEVELOPMENT_PROJECTS/APPLICATION-PROJECTS/frigate/.env
StandardOutput=journal
StandardError=journal
# Same strict success policy as frigate-stack.service: only exit 0
# counts. If bring-up.sh returns 1..5, systemd records the watchdog
# run as failed, but the timer continues firing every 5 min until
# bring-up.sh returns 0. This is the correct self-healing loop
# for a boot-time config regression.
SuccessExitStatus=0
# Cap each run well below the timer interval to avoid pile-up.
TimeoutStartSec=420
