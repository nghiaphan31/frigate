# TRT runtime libs — 4.4GB binary, not committed to git.
# Reproduced by: pip install --target=./trt-libs tensorrt-cu12-libs==10.9.0.34 tensorrt-cu12-bindings==10.9.0.34
# See docker-compose.calypso.yml TRT RUNTIME LIBS section for details.
trt-libs/

# TRT engine cache and model cache — large binary, machine-specific, regenerated on first run.
# Exclude ONNX model files (100-300 MB each) and TRT compiled engine binaries.
# Only small JSON/tokenizer metadata files are committed.
trt-cache/tensorrt/
trt-cache/**/*.onnx
trt-cache/jinaai/**/*.onnx
# TRT compiled engine binaries: 32-char hex filename with no extension (e.g. 6ea1f38d...)
# Cannot glob precisely — use a sentinel pattern; add specific names below if needed.
trt-cache/6ea1f38db36e21f44a1eb1071d9958ed
