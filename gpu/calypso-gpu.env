# /etc/calypso-gpu.env — GPU budget + coordination for all Calypso workloads
# Managed by: calypso-host
# Read by: all GPU systemd units via EnvironmentFile=

# Hardware
GPU_TOTAL_MEM_MB=16384
GPU_DEVICE_INDEX=0
GPU_POWER_LIMIT_W=150
GPU_MAX_CLOCK_MHZ=2400

# Per-workload memory budgets (in MB)
GPU_FRIGATE_BUDGET_MB=6144
GPU_IMMICH_BUDGET_MB=3072
GPU_CAS_CORE_BUDGET_MB=2048
GPU_DEMUCS_BUDGET_MB=2048
GPU_LATE_CLASSIFY_BUDGET_MB=4096
GPU_RESERVE_MB=3072

# LLM & CUDA execution constraints
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=1m
CUDA_MODULE_LOADING=LAZY

# Shared paths
GPU_AUDIT_LOG=/var/log/gpu-audit.jsonl
GPU_RECOVERY_LOG=/var/log/gpu-recovery.log

# MQTT coordination
GPU_MQTT_HOST=192.168.50.125
GPU_MQTT_PORT=1883
GPU_MQTT_STATE_TOPIC=calypso_frigate/maintenance/gpu-state
GPU_MQTT_THROTTLE_TOPIC=calypso_frigate/maintenance/throttle
GPU_MQTT_AUDIT_TOPIC=calypso_frigate/maintenance/audit

# Watchdog thresholds
GPU_TEMP_WARN=80
GPU_TEMP_CRITICAL=90
GPU_MEM_FREE_WARN_MB=2048
GPU_MEM_FREE_CRITICAL_MB=1024
GPU_UTIL_STUCK_THRESHOLD=99
GPU_UTIL_STUCK_MINUTES=10

# Recovery caps
GPU_MAX_RECOVERIES_PER_HOUR=3

