[Unit]
Description=Immich ML — CLIP embeddings (GPU P2)
After=docker.service frigate-stack.service
Wants=frigate-stack.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/calypso-gpu.env
ExecStartPre=/usr/local/bin/gpu-usage-logger.sh check cas-immich-ml ${GPU_IMMICH_BUDGET_MB}
ExecStart=/usr/bin/docker start cas-immich-ml
ExecStartPost=-/usr/local/bin/gpu-usage-logger.sh start cas-immich-ml
ExecStop=/usr/bin/docker stop cas-immich-ml
ExecStopPost=-/usr/local/bin/gpu-usage-logger.sh stop cas-immich-ml
Nice=10
IOSchedulingClass=best-effort
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
Restart=no

[Install]
WantedBy=multi-user.target

